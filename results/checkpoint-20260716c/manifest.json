{
  "base_args": [
    "--config-path",
    "{rlinf_root}/examples/embodiment/config",
    "--config-name",
    "maniskill_rlt_stage2_ac_mlp",
    "runner.logger.logger_backends=null",
    "runner.only_eval=false",
    "runner.max_steps=1",
    "runner.val_check_interval=1",
    "runner.save_interval=-1",
    "env.train.total_num_envs=1",
    "env.train.max_episode_steps=20",
    "env.train.max_steps_per_rollout_epoch=20",
    "env.train.rlt_policy_switch.task_mode=critical_phase",
    "env.train.rlt_policy_switch.trigger_mode=always_on",
    "env.train.rlt_policy_switch.expert_takeover.enable=false",
    "env.eval.total_num_envs=1",
    "env.eval.max_episode_steps=20",
    "env.eval.max_steps_per_rollout_epoch=20",
    "env.eval.rlt_policy_switch.task_mode=critical_phase",
    "env.eval.rlt_policy_switch.trigger_mode=always_on",
    "env.eval.rlt_policy_switch.expert_takeover.enable=false",
    "rollout.rlt_feature_model.model_path={model_path}",
    "+rollout.rlt_feature_model.openpi_data.norm_stats_path={dataset_path}/norm_stats.json",
    "rollout.expert_model=null",
    "actor.micro_batch_size=1",
    "actor.global_batch_size=1",
    "algorithm.actor_weight_schedule.enable=false",
    "algorithm.update_epoch=1",
    "algorithm.replay_buffer.min_buffer_size=1",
    "algorithm.rlt_schedule.warmup_min_size=1",
    "algorithm.rlt_schedule.warmup_post_collect_updates=1",
    "algorithm.rlt_schedule.train_every_transitions=1",
    "algorithm.rlt_schedule.max_updates_per_train_step=1"
  ],
  "default_output_root": "/root/qualia-wrapper-runs",
  "description": "Two-run Phase 1 checkpoint using RLinf Stage-2 RLT actor-critic with a one-episode train/eval smoke budget.",
  "entrypoint": "{rlinf_root}/examples/embodiment/train_embodied_agent.py",
  "environment": {
    "EMBODIED_PATH": "{rlinf_root}/examples/embodiment",
    "PYTHONPATH": "{rlinf_root}",
    "RAY_TMPDIR": "/tmp/qualia-ray-{run_id}",
    "SAPIEN_RENDER_SYSTEM": "egl"
  },
  "logger_path_override": "runner.logger.log_path",
  "name": "maniskill-rlt-phase1-smoke",
  "parameters": {
    "learning_rate": {
      "override": "actor.optim.lr",
      "value": 0.0001
    },
    "regularization_strength": {
      "override": "algorithm.bc_weight",
      "value": 1.0
    }
  },
  "paths": {
    "dataset_path": "/workspace/qualia/assets/maniskill_smoke",
    "model_path": "/root/qualia-assets/pi05_base",
    "rlinf_root": "/workspace/qualia/RLinf"
  },
  "python": "{rlinf_root}/.venv/bin/python",
  "rule": {
    "learning_rate_factor": 0.5,
    "use_loss_tiebreaker": false,
    "min_relative_loss_improvement": 0.01,
    "plateau_window": 3,
    "regularization_factor": 0.8,
    "success_epsilon": 1e-09,
    "success_target": 0.85
  },
  "schema_version": 1,
  "timeout_seconds": 1800,
  "working_directory": "{rlinf_root}"
}
